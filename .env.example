# Secrets & environment overrides for Zapflix.
# Copy to `.env` and fill in. Values here override config.json at runtime.
# `.env` is gitignored — never commit real secrets.

# Real-Debrid API key (https://real-debrid.com/apitoken)
RD_API_KEY=

# Torrentio config string WITH your RD key baked in, so streams are marked [RD+]
# when cached. Generate at https://torrentio.strem.fun/configure (pick Real-Debrid),
# then copy the path segment between the host and /manifest.json.
# Example: sort=qualitysize|qualityfilter=cam,scr|realdebrid=YOUR_RD_API_KEY
TORRENTIO_CONFIG=

# aria2 on the NAS
ARIA2_HOST=http://192.168.178.35
ARIA2_PORT=6801
ARIA2_SECRET=
ARIA2_DOWNLOAD_DIR=/downloads
