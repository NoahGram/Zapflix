{
    "torrentio": {
        "base_url": "https://torrentio.strem.fun",
        "config": "sort=qualitysize|qualityfilter=cam,scr|realdebrid=YOUR_RD_API_KEY",
        "preferred_quality": ["1080p", "720p"],
        "exclude_keywords": ["cam", "hdcam", "telesync", "telecine"],
        "max_results_per_episode": 5
    },
    "real_debrid": {
        "enabled": true,
        "api_key": "YOUR_API_KEY_HERE"
    },
    "aria2": {
        "enabled": true,
        "host": "http://YOUR_NAS_IP",
        "port": 6800,
        "secret": "",
        "download_dir": "/path/to/media/library",
        "poll_timeout": 900,
        "library_folders": ["movies", "series", "anime"],
        "default_movie_folder": "movies",
        "default_series_folder": "series"
    },
    "download": {
        "delay_between_episodes": 1.5,
        "delay_between_seasons": 5,
        "auto_select_best": true,
        "dry_run": false,
        "profile": "jellyfin"
    },
    "monitoring": {
        "check_interval_hours": 6
    }
}
